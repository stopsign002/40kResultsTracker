# Drop this file at: ~/sites/base/conf.d/40k.caddy
# Then: docker exec caddy caddy reload --config /etc/caddy/Caddyfile

40k.thewheeliebois.com {
    # SSE endpoint: needs flush_interval so chunks aren't buffered;
    # `encode` (gzip/zstd) is intentionally NOT in this handler.
    handle /api/events {
        rewrite * /events
        reverse_proxy 40k-api:3000 {
            flush_interval -1
        }
    }
    handle_path /api/* {
        reverse_proxy 40k-api:3000
    }
    # Game photos, written by the API into the site's uploads/ volume and
    # served straight off disk — the Node process is not in the read path.
    # Deliberately outside app/ so uploads stay out of git and out of the
    # SPA's try_files fallback.
    handle_path /uploads/* {
        root * /srv/40kResultsTracker/uploads
        encode gzip zstd
        header Cache-Control "public, max-age=31536000, immutable"
        file_server
    }
    handle {
        root * /srv/40kResultsTracker/app
        encode gzip zstd
        file_server
        try_files {path} /index.html
    }
}
