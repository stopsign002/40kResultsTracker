DATABASE_URL=postgresql://40k_user:CHANGEME@postgres:5432/40k_db
SESSION_SECRET=CHANGEME_long_random_string
PORT=3000
NODE_ENV=production
# Admin bootstrap (only used when no users exist in the DB)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEME
# Count digital (Tabletop Simulator) games toward war map / rankings / stats.
# Set to false to exclude them from all competitive surfaces at once (browse is
# unaffected). Default (unset) = true.
INCLUDE_DIGITAL_IN_STATS=true
# New-game notification email, relayed through the shared `mailer` container on
# the `web` network. Both are optional — if either is missing, lib/mail.js skips
# the notification silently. MAILER_TOKEN is the same token as in
# ~/sites/sites/mailer/.env; do not commit the real value.
MAILER_URL=http://mailer:3000/send
MAILER_TOKEN=CHANGEME
# NOTE: UPLOAD_DIR is the one variable the code reads that does NOT belong here.
# docker-compose.yml sets it in the service's `environment:` block (/data/uploads,
# bind-mounted from ./uploads). Setting it in .env would be overridden anyway.
